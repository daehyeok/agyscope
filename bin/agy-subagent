#!/usr/bin/env python3
"""agy-subagent: read-only panel listing the subagents of an Antigravity agent session.

    agy-subagent [--pid PID] [--block BLOCK] [--conversation ID] [settings...]
                                      Textual panel, run through uv (refreshes every second)
    agy-subagent --once ...           print the list once as plain text
    agy-subagent --view CHILD ...     print one subagent's view, fully unfolded (CHILD may be a prefix)

Which conversation: --pid (the agent process; followed through the presence lock it
holds open, found with lsof or /proc), then the block pointer the hook writes for
--block, then --conversation. The data directory comes from that lock (or the
pointer) when there is one; --app-dir and the other settings are the fallback.

Settings (flags override AGY_SUBAGENT_* variables, which override the config file):
    --app-dir DIR          agent data directory (default ~/.gemini/antigravity-cli)
    --keymap emacs|vim     panel keys (default emacs)
    --keys-json JSON       extra keys: {"down": ["J"], ...}
    --pager-json JSON      pager argv: ["bat", "--paging=always"]

See README.md for the keys and the config file.
"""

import os
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
PLUGIN_DIR = os.path.dirname(HERE)
sys.path.insert(0, PLUGIN_DIR)

from agy_subagent_py import cli  # noqa: E402


def uv_argv(plugin_dir, argv):
    """The `uv run` command that starts the Textual panel from the plugin's own project.

    No lockfile ships with the plugin: uv resolves textual from the host's own index
    configuration on first run and keeps a local (gitignored) uv.lock and .venv."""
    return ["uv", "run", "--project", plugin_dir, "--quiet",
            "python", "-m", "agy_subagent_py.app"] + list(argv)


def uv_env(plugin_dir, environ):
    """environ for uv: the plugin dir leads PYTHONPATH, since `uv run --project` keeps the caller's
    cwd and `python -m agy_subagent_py.app` would not find the package otherwise; a read-only
    plugin dir keeps its venv under the user's cache dir instead."""
    env = dict(environ)
    env["PYTHONPATH"] = os.pathsep.join(p for p in (plugin_dir, env.get("PYTHONPATH")) if p)
    if not os.access(plugin_dir, os.W_OK) and not env.get("UV_PROJECT_ENVIRONMENT"):
        cache = env.get("XDG_CACHE_HOME") or os.path.join(env.get("HOME") or os.path.expanduser("~"), ".cache")
        env["UV_PROJECT_ENVIRONMENT"] = os.path.join(cache, "rex-agy-subagent", "venv")
    return env


def wait_for_enter(message):
    """Show message and keep the pane open until Enter (or EOF)."""
    print(message)
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        pass


def main(argv):
    args = cli.parse(argv)
    if args.once or args.view:
        return cli.run_text(cli.setup(argv))

    if not shutil.which("uv"):
        wait_for_enter("agy-subagent: the panel needs uv (https://docs.astral.sh/uv/); "
                       "--once/--view work without it")
        return 1
    # app.main focuses the agent block itself, after a `close`.
    rc = subprocess.call(uv_argv(PLUGIN_DIR, argv), env=uv_env(PLUGIN_DIR, os.environ))
    if rc in (0, 1):
        return rc
    wait_for_enter("agy-subagent: uv failed (exit %d); first run needs network to fetch textual, "
                   "and python3 >= 3.9" % rc)
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
